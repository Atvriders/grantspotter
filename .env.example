# GrantSpotter configuration. Copy to .env and fill in the two required values.
#   cp .env.example .env

# Host port published by docker compose. The container always listens on 3030.
# 3030 is commonly already claimed on a busy host; change this, not the compose file.
HOST_PORT=3030

# Port the server listens on inside the container. Leave this alone.
PORT=3030

# REQUIRED. No default exists and the server refuses to start without it. It must be
# at least 32 characters.
# Generate with: openssl rand -hex 32
SESSION_SECRET=

# REQUIRED. No default, and deliberately blank here: a copied file must fail loudly
# rather than crawl anonymously. An http(s) URL a site owner can visit to find out who
# is polling them — it goes into the crawler's User-Agent so the ~25 small nonprofits
# in this corpus can identify and contact the operator. Use a page you control, for
# example https://www.example.org/grantspotter.
CONTACT_URL=

# SQLite database, snapshots and fixture cache live here. Inside the container this is
# the mounted volume; losing it loses the corpus.
DATA_DIR=/data

# Nightly change detection. Nothing in this corpus changes faster than weekly, so
# nightly is the right cadence; the schedule is jittered in code.
CRAWL_ENABLED=true
CRAWL_CRON=17 3 * * *

# Optional. With no key everything still works: deterministic parsers, rule-based
# scoring and the copy-prompt flow. If present, the crawler additionally uses it to
# parse messy pages. Never on the read path, and it never drafts a narrative.
ANTHROPIC_API_KEY=

# Optional. Free Login.gov key for api.simpler.grants.gov. Never a hard dependency.
SIMPLER_GRANTS_API_KEY=
