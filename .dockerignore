# The build context. Everything the image needs is compiled inside the build stage,
# so host build output and local state stay out: they are the wrong architecture as
# often as not, and `data/*.sqlite` is somebody's real database.
node_modules
**/node_modules
.git
.gitignore
.github
dist
**/dist
coverage
# Kept even though configuration moved into docker-compose.yml: an operator's `.env` is still a
# file that can exist here, and baking one into an image would ship their secret to whoever pulls it.
.env
.env.local
data/*.sqlite
data/*.sqlite-*
data/snapshots
e2e
playwright.config.ts
playwright-report
test-results
# Specs, plans and research are for humans working in the repository, not for the
# runtime image.
docs
.superpowers
*.log
.DS_Store
