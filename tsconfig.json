{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": { "@grantspotter/core": ["packages/core/src/index.ts"] }
  },
  "include": [
    "packages/core/src/**/*.ts",
